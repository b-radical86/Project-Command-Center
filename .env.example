# Project Command Center Configuration

# GitHub Personal Access Token (or uses 'gh auth token' automatically)
GITHUB_TOKEN=gho_your_github_token_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Preferred Primary Free Model (Waterfal: nvidia/nemotron-3-ultra-550b-a55b:free -> nvidia/nemotron-3.5-super-vl:free -> thinkingmachines/inkling:free -> nvidia/nemotron-3-super-120b-a12b:free -> openrouter/free)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Host and Port
HOST=127.0.0.1
PORT=8000
