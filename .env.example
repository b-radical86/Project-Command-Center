# Project Command Center Configuration

# GitHub Personal Access Token (or uses 'gh auth token' automatically if left blank)
# Required scopes: repo, read:org
GITHUB_TOKEN=gho_your_github_token_here

# Google AI Studio API Key (Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Primary Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Host and Port
HOST=127.0.0.1
PORT=8000
